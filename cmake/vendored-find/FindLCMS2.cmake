# imgcat2 shim (see README.md): lcms2 for libjxl's CMS (JPEGXL_ENABLE_SKCMS=OFF).
# libjxl links a target named "lcms2"; the top-level aliases it to the lcms2 provider.
if(IMGCAT2_VENDORED_LCMS2_LIBRARIES)
	set(LCMS2_FOUND TRUE)
	set(LCMS2_LIBRARY ${IMGCAT2_VENDORED_LCMS2_LIBRARIES})
	set(LCMS2_LIBRARIES ${IMGCAT2_VENDORED_LCMS2_LIBRARIES})
	set(LCMS2_INCLUDE_DIR ${IMGCAT2_VENDORED_LCMS2_INCLUDE_DIRS})
	set(LCMS2_INCLUDE_DIRS ${IMGCAT2_VENDORED_LCMS2_INCLUDE_DIRS})
	set(LCMS2_VERSION ${IMGCAT2_VENDORED_LCMS2_VERSION})
else()
	set(LCMS2_FOUND FALSE)
endif()
