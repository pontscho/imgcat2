# Merge static archives into one (fat libimg2.a).
#   cmake -DMODE=mri|libtool -DAR=<ar> -DRANLIB=<ranlib> -DINPUTS=<file, one archive per line> -DOUTPUT=<lib.a>
#         -P cmake/scripts/img2_fat_archive.cmake
# - inputs are de-duplicated, keeping the first occurrence (merge order == link order);
# - mri: GNU ar MRI script (CREATE / ADDLIB... / SAVE / END) through `ar -M`, then ranlib;
# - libtool: `libtool -static -o` (macOS: best effort, untested).
# The archive is written next to OUTPUT and renamed into place, so an interrupted run leaves no partial OUTPUT.

foreach(_v MODE INPUTS OUTPUT)
	if(NOT DEFINED ${_v} OR "${${_v}}" STREQUAL "")
		message(FATAL_ERROR "img2_fat_archive: -D${_v}=... is required")
	endif()
endforeach()

file(READ "${INPUTS}" _raw)
if(_raw MATCHES "[+; ]")
	# MRI scripts cannot quote; ';' would also split the CMake list
	message(FATAL_ERROR "img2_fat_archive: an input path contains '+', ';' or a space (unsupported by ar -M):\n${_raw}")
endif()
string(REPLACE "\n" ";" _lines "${_raw}")
set(_inputs "")
foreach(_l IN LISTS _lines)
	string(STRIP "${_l}" _l)
	if(_l STREQUAL "")
		continue()
	endif()
	if(NOT EXISTS "${_l}")
		message(FATAL_ERROR "img2_fat_archive: input archive does not exist: ${_l}")
	endif()
	list(FIND _inputs "${_l}" _idx)
	if(_idx EQUAL -1)
		list(APPEND _inputs "${_l}")
	endif()
endforeach()
if(_inputs STREQUAL "")
	message(FATAL_ERROR "img2_fat_archive: no input archives in ${INPUTS}")
endif()
if(OUTPUT MATCHES "[+; ]")
	message(FATAL_ERROR "img2_fat_archive: output path contains '+', ';' or a space: ${OUTPUT}")
endif()

set(_tmp "${OUTPUT}.tmp")
file(REMOVE "${OUTPUT}" "${_tmp}")
if(MODE STREQUAL "mri")
	if(NOT DEFINED AR OR AR STREQUAL "")
		message(FATAL_ERROR "img2_fat_archive: -DAR=... is required in mri mode")
	endif()
	set(_mri "CREATE ${_tmp}\n")
	foreach(_a IN LISTS _inputs)
		string(APPEND _mri "ADDLIB ${_a}\n")
	endforeach()
	string(APPEND _mri "SAVE\nEND\n")
	file(WRITE "${OUTPUT}.mri" "${_mri}")
	execute_process(COMMAND "${AR}" -M INPUT_FILE "${OUTPUT}.mri" RESULT_VARIABLE _rv OUTPUT_VARIABLE _o ERROR_VARIABLE _e)
	if(NOT _rv EQUAL 0)
		message(FATAL_ERROR "img2_fat_archive: ${AR} -M failed (${_rv}):\n${_o}${_e}")
	endif()
	if(DEFINED RANLIB AND NOT RANLIB STREQUAL "")
		execute_process(COMMAND "${RANLIB}" "${_tmp}" RESULT_VARIABLE _rv ERROR_VARIABLE _e)
		if(NOT _rv EQUAL 0)
			message(FATAL_ERROR "img2_fat_archive: ${RANLIB} failed (${_rv}):\n${_e}")
		endif()
	endif()
elseif(MODE STREQUAL "libtool")
	# macOS: best effort, untested
	execute_process(COMMAND libtool -static -o "${_tmp}" ${_inputs} RESULT_VARIABLE _rv ERROR_VARIABLE _e)
	if(NOT _rv EQUAL 0)
		message(FATAL_ERROR "img2_fat_archive: libtool failed (${_rv}):\n${_e}")
	endif()
else()
	message(FATAL_ERROR "img2_fat_archive: unknown MODE '${MODE}' (mri|libtool)")
endif()
file(RENAME "${_tmp}" "${OUTPUT}")
list(LENGTH _inputs _n)
message(STATUS "img2_fat_archive: ${OUTPUT} from ${_n} archives")
