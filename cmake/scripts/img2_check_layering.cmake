# Layering guard (cmake -P).
#   cmake -DMODE=lib|cli -DROOT=<repo> -P cmake/scripts/img2_check_layering.cmake
#
# MODE=lib: src/libimg2/**/*.{c,h} (and include/img2/*.h once it exists) must not include CLI headers
#           (quoted include paths containing imgcat2/, cli.h, pipeline.h, base64.h, terminal/ or ansi/)
#           and must not use the token cli_options_t.
# MODE=cli: src/imgcat2/*.{c,h} and src/imgcat2/{ansi,terminal}/** (never compat/) must not include
#           headers outside src/imgcat2 (or libimg2/ paths) and must not use the token IMG2_HAVE_.
#
# Files are read whole (file(READ)), not with file(STRINGS): CMake list splitting on ';' and '[' would
# merge or split source lines and hide matches.

if(NOT DEFINED MODE OR NOT DEFINED ROOT)
	message(FATAL_ERROR "usage: cmake -DMODE=lib|cli -DROOT=<repo> -P img2_check_layering.cmake")
endif()

set(_violations "")
set(_inc_re "\n[ \t]*#[ \t]*include[ \t]*\"[^\"\n]*\"")

# Quoted include paths of a file -> out var (one list element per include)
function(_img2_quoted_includes file out)
	file(READ "${file}" _c)
	set(_c "\n${_c}")
	string(REGEX MATCHALL "${_inc_re}" _m "${_c}")
	set(_paths "")
	foreach(_i IN LISTS _m)
		string(REGEX REPLACE "^.*\"([^\"]*)\"$" "\\1" _p "${_i}")
		list(APPEND _paths "${_p}")
	endforeach()
	set(${out} "${_paths}" PARENT_SCOPE)
endfunction()

function(_img2_has_regex file regex out)
	file(READ "${file}" _c)
	if(_c MATCHES "${regex}")
		set(${out} TRUE PARENT_SCOPE)
	else()
		set(${out} FALSE PARENT_SCOPE)
	endif()
endfunction()

if(MODE STREQUAL "lib")
	file(GLOB_RECURSE _files LIST_DIRECTORIES false "${ROOT}/src/libimg2/*.c" "${ROOT}/src/libimg2/*.h")
	if(IS_DIRECTORY "${ROOT}/include/img2")
		file(GLOB _pub LIST_DIRECTORIES false "${ROOT}/include/img2/*.h")
		list(APPEND _files ${_pub})
	endif()
	list(SORT _files)
	foreach(_f IN LISTS _files)
		file(RELATIVE_PATH _rel "${ROOT}" "${_f}")
		_img2_quoted_includes("${_f}" _incs)
		foreach(_inc IN LISTS _incs)
			if(_inc MATCHES "imgcat2/|cli\\.h|pipeline\\.h|base64\\.h|terminal/|ansi/")
				list(APPEND _violations "${_rel}: forbidden include \"${_inc}\"")
			endif()
		endforeach()
		_img2_has_regex("${_f}" "(^|[^A-Za-z0-9_])cli_options_t([^A-Za-z0-9_]|$)" _hit)
		if(_hit)
			list(APPEND _violations "${_rel}: forbidden token cli_options_t")
		endif()
	endforeach()
elseif(MODE STREQUAL "cli")
	set(_cli "${ROOT}/src/imgcat2")
	file(GLOB _files LIST_DIRECTORIES false "${_cli}/*.c" "${_cli}/*.h")
	file(GLOB_RECURSE _sub LIST_DIRECTORIES false
		"${_cli}/ansi/*.c" "${_cli}/ansi/*.h" "${_cli}/terminal/*.c" "${_cli}/terminal/*.h")
	list(APPEND _files ${_sub})
	list(SORT _files)
	foreach(_f IN LISTS _files)
		file(RELATIVE_PATH _rel "${ROOT}" "${_f}")
		get_filename_component(_dir "${_f}" DIRECTORY)
		_img2_quoted_includes("${_f}" _incs)
		foreach(_inc IN LISTS _incs)
			get_filename_component(_abs "${_inc}" ABSOLUTE BASE_DIR "${_dir}")
			file(RELATIVE_PATH _r "${_cli}" "${_abs}")
			if(_inc MATCHES "libimg2/" OR _r MATCHES "^\\.\\./")
				list(APPEND _violations "${_rel}: include outside src/imgcat2 \"${_inc}\"")
			endif()
		endforeach()
		_img2_has_regex("${_f}" "IMG2_HAVE_" _hit)
		if(_hit)
			list(APPEND _violations "${_rel}: forbidden token IMG2_HAVE_")
		endif()
	endforeach()
else()
	message(FATAL_ERROR "img2_check_layering: unknown MODE '${MODE}' (lib|cli)")
endif()

if(_violations)
	list(LENGTH _violations _n)
	foreach(_v IN LISTS _violations)
		message(STATUS "LAYERING: ${_v}")
	endforeach()
	message(FATAL_ERROR "img2_check_layering (${MODE}): ${_n} violation(s)")
endif()
message(STATUS "img2_check_layering (${MODE}): ok")
