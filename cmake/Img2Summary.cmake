# Purpose: Configuration summary printed at the end of configure.
# Inputs:  *_FOUND, *_LIBRARIES, *_LIB_TYPE, IMG2_ENABLE_*, IMG2_USE_SYSTEM_*, IMG2_BUILD_TESTS.
# Outputs: Nothing (STATUS messages only).

# Print configuration summary
message(STATUS "")
message(STATUS "imgcat2 Configuration Summary")
message(STATUS "============================")
message(STATUS "Version: ${PROJECT_VERSION}")
message(STATUS "Build type: ${CMAKE_BUILD_TYPE}")
message(STATUS "C compiler: ${CMAKE_C_COMPILER}")
message(STATUS "C standard: C${CMAKE_C_STANDARD}")
message(STATUS "")
message(STATUS "Core Dependencies (required):")
message(STATUS "  libpng: ${PNG_LIBRARIES} (${PNG_LIB_TYPE})")
if(PNG_APNG_SUPPORTED_CHECK)
	message(STATUS "    APNG support: YES")
else()
	message(STATUS "    APNG support: NO (requires libpng >= 1.6.0 with --enable-apng)")
endif()
message(STATUS "  Compression: ${COMPRESSION_LIB_TYPE}")
message(STATUS "    Libraries: ${ZLIB_LIBRARIES}")
message(STATUS "  libjpeg: ${JPEG_LIBRARIES} (${JPEG_LIB_TYPE})")
message(STATUS "")
message(STATUS "Optional Dependencies:")
if(GIF_FOUND)
	message(STATUS "  giflib: ${GIF_LIBRARY} (${GIF_LIB_TYPE})")
endif()
if(WEBP_FOUND)
	message(STATUS "  libwebp: ${WEBP_LIBRARIES} (${WEBP_LIB_TYPE})")
endif()
if(HEIF_FOUND)
	if(NOT IMG2_USE_SYSTEM_HEIF)
		message(STATUS "  libheif: ${HEIF_LIBRARIES} (${HEIF_LIB_TYPE})")
		string(REPLACE ";" ", " HEIF_CODECS_STR "${HEIF_CODECS}")
		message(STATUS "    codecs: ${HEIF_CODECS_STR}")
	elseif(UNIX AND NOT APPLE)
		message(STATUS "  libheif: ${HEIF_CUSTOM_LIBS}")
		# Show detected codecs
		set(HEIF_CODECS "")
		if(DE265_FOUND)
			list(APPEND HEIF_CODECS "de265")
		endif()
		if(KVAZAAR_FOUND)
			list(APPEND HEIF_CODECS "kvazaar")
		endif()
		if(AOM_FOUND)
			list(APPEND HEIF_CODECS "aom")
		endif()
		if(OPENJP2_FOUND)
			list(APPEND HEIF_CODECS "openjp2")
		endif()
		if(HEIF_CODECS)
			string(REPLACE ";" ", " HEIF_CODECS_STR "${HEIF_CODECS}")
			message(STATUS "    codecs: ${HEIF_CODECS_STR}")
		else()
			message(STATUS "    codecs: (none available)")
		endif()
	else()
		message(STATUS "  libheif: ${HEIF_LDFLAGS}")
	endif()
endif()
if(TIFF_FOUND)
	if(NOT IMG2_USE_SYSTEM_TIFF)
		message(STATUS "  libtiff: ${TIFF_LIBRARIES} (${TIFF_LIB_TYPE})")
	elseif(UNIX AND NOT APPLE)
		message(STATUS "  libtiff: ${TIFF_STATIC_LDFLAGS}")
	else()
		message(STATUS "  libtiff: ${TIFF_LIBRARIES}")
	endif()
endif()
if(RAW_FOUND)
	if(NOT IMG2_USE_SYSTEM_RAW)
		message(STATUS "  libraw: ${RAW_LIBRARIES} (${RAW_LIB_TYPE})")
	elseif(UNIX AND NOT APPLE)
		message(STATUS "  libraw: ${RAW_STATIC_LDFLAGS}")
	else()
		message(STATUS "  libraw: ${RAW_LDFLAGS}")
	endif()
endif()
if(JXL_FOUND)
	if(NOT IMG2_USE_SYSTEM_JXL)
		message(STATUS "  libjxl: ${JXL_LIBRARIES} (${JXL_LIB_TYPE})")
	elseif(UNIX AND NOT APPLE)
		message(STATUS "  libjxl: ${JXL_STATIC_LDFLAGS}")
	else()
		message(STATUS "  libjxl: ${JXL_CUSTOM_LIBS}")
	endif()
endif()
if(NOT GIF_FOUND AND NOT WEBP_FOUND AND NOT HEIF_FOUND AND NOT TIFF_FOUND AND NOT RAW_FOUND AND NOT JXL_FOUND)
	message(STATUS "  (none)")
endif()
message(STATUS "")
if(IMG2_ENABLE_RESVG AND RESVG_FOUND)
	message(STATUS "SVG Decoder: resvg ${RESVG_VERSION}")
else()
	message(STATUS "SVG Decoder: nanosvg")
endif()
message(STATUS "")
message(STATUS "Optional Format Support:")
message(STATUS "  GIF:  ${IMG2_ENABLE_GIF}")
message(STATUS "  WebP: ${IMG2_ENABLE_WEBP}")
message(STATUS "  HEIF: ${IMG2_ENABLE_HEIF}")
message(STATUS "  TIFF: ${IMG2_ENABLE_TIFF}")
message(STATUS "  RAW:  ${IMG2_ENABLE_RAW}")
message(STATUS "  JXL:  ${IMG2_ENABLE_JXL}")
message(STATUS "")
message(STATUS "Metadata Support:")
message(STATUS "  EXIF/XMP: ${IMG2_ENABLE_EXIF_READER}")
message(STATUS "")
message(STATUS "Other Options:")
message(STATUS "  Testing: ${IMG2_BUILD_TESTS}")
message(STATUS "  clang-tidy: ${IMG2_ENABLE_CLANG_TIDY}")
message(STATUS "  clang-format: ${IMG2_ENABLE_CLANG_FORMAT}")
if(APPLE)
	if(STATIC_LIBCXX_LIBS)
		message(STATUS "  libc++ linking: static")
	else()
		message(STATUS "  libc++ linking: dynamic")
	endif()
endif()
message(STATUS "")
